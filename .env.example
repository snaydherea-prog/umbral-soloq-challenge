# Copia este archivo a ".env" y rellena tus valores reales.
# NUNCA subas el archivo ".env" a un repositorio publico.

# Tu Riot API Key (Development o Personal). Consiguela en https://developer.riotgames.com
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Cluster regional para resolver Riot ID -> PUUID (account-v1).
# Valores tipicos: americas | europe | asia | esports
RIOT_REGIONAL_ROUTE=americas

# Plataforma/servidor donde juegan tus participantes (league-v4).
# Ejemplos: la1 (LAN), la2 (LAS), na1, euw1, eun1, kr, br1
RIOT_PLATFORM_ROUTE=la1

# Puerto donde corre el servidor
PORT=3000

# Token simple para proteger el endpoint de administracion (agregar/quitar participantes)
ADMIN_TOKEN=cambia-esto-por-algo-secreto

# Cada cuantos segundos se refresca el leaderboard automaticamente (minimo 5)
REFRESH_INTERVAL_SECONDS=45

# Desfase horario (UTC) de la zona donde vive el challenge, para saber cuando es "medianoche"
# y reiniciar el conteo diario de partidas. Ecuador/Peru/Colombia (LAN) = -5
TIMEZONE_OFFSET_HOURS=-5

# Maximo de participantes que se pueden unir a traves del formulario publico
MAX_PARTICIPANTS=50

# Nivel minimo de cuenta requerido para participar (0 = sin minimo)
MIN_SUMMONER_LEVEL=30
